# База данных PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# NextAuth
NEXTAUTH_URL="https://k35-bc.ru"
NEXTAUTH_SECRET="сгенерировать: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Скрытый путь к админке — НЕ использовать NEXT_PUBLIC_!
# Придумать сложный: bc-panel-k35-2025 (не "admin", не "panel")
ADMIN_SLUG="your-secret-admin-slug"

# Данные администратора (вписать вручную)  — создаётся (админ пользователь) автоматически при npm run setup
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-password"

# Email-уведомления через Resend (https://resend.com)
# Домен верифицировать не нужно — письма идут только на EMAIL_TO
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_TO="your@email.com"
EMAIL_FROM="onboarding@resend.dev"

# Карта: yandex или 2gis
NEXT_PUBLIC_MAP_PROVIDER="yandex"

# ⚠️ ПЕРЕД ДЕПЛОЕМ НА СЕРВЕР:
# Раскомментировать строку output: 'standalone' в next.config.ts (нужно для Docker)
