# База данных PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/businesscenter"

# NextAuth — URL вашего сайта и случайный секрет (минимум 32 символа)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-secret-minimum-32-characters-long"

# Скрытый путь к админке — НЕ использовать NEXT_PUBLIC_!
# Пример: admin-bc-2025-xK9m
ADMIN_SLUG="your-secret-admin-slug"

# Данные администратора
ADMIN_EMAIL="admin@example.com"
# Сгенерировать hash: npx ts-node scripts/hash-password.ts yourpassword
ADMIN_PASSWORD_HASH=""

# Email для отправки уведомлений о заявках
EMAIL_HOST="smtp.yandex.ru"
EMAIL_PORT="465"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_TO=""

# Хранилище изображений (Uploadthing ИЛИ S3)
UPLOADTHING_SECRET=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# Карта: yandex или 2gis
NEXT_PUBLIC_MAP_PROVIDER="yandex"
