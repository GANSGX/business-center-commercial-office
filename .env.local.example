# Скопируй этот файл в .env.local и заполни значения
# cp .env.local.example .env.local

# БД — для локальной разработки через Docker (npm run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/businesscenter

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-minimum-32-characters-long!!

# Скрытый путь к админке (придумай свой)
ADMIN_SLUG=my-secret-admin-slug

# Учётные данные администратора (создаются автоматически при npm run setup)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# Карта
NEXT_PUBLIC_MAP_PROVIDER=yandex
